// Prisma schema for Autonomous Agentic Support Service
// Strictly adhering to Section 4 of PROJECT_SPEC.md

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  AGENT
  ADMIN
}

enum OrderStatus {
  PLACED
  SHIPPED
  DELIVERED
  RETURNED
  REFUNDED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ESCALATED
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  NEEDS_HUMAN
}

enum AgentDecision {
  REFUND
  REPLACEMENT
  REJECT
  ESCALATE
}

enum AgentStepType {
  LLM_THOUGHT
  TOOL_CALL
  TOOL_RESULT
  GUARDRAIL
  FINAL
}

enum EscalationStatus {
  PENDING
  RESOLVED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  role         Role          @default(CUSTOMER)
  createdAt    DateTime      @default(now())
  orders       Order[]
  tickets      Ticket[]
  escalations  Escalation[]  @relation("AssignedAgent")

  @@map("users")
}

model Product {
  id               String      @id @default(uuid())
  name             String
  sku              String      @unique
  price            Decimal     @db.Decimal(10, 2)
  warrantyMonths   Int         @default(12)
  returnWindowDays Int         @default(30)
  orderItems       OrderItem[]

  @@map("products")
}

model Order {
  id                String             @id @default(uuid())
  orderNumber       String             @unique
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            OrderStatus        @default(PLACED)
  totalAmount       Decimal            @db.Decimal(10, 2)
  orderedAt         DateTime           @default(now())
  deliveredAt       DateTime?
  items             OrderItem[]
  tickets           Ticket[]
  refunds           Refund[]
  replacementOrders ReplacementOrder[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(10, 2)

  @@map("order_items")
}

model Ticket {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  message     String
  status      TicketStatus  @default(OPEN)
  createdAt   DateTime      @default(now())
  agentRuns   AgentRun[]
  escalations Escalation[]

  @@index([userId])
  @@map("tickets")
}

model AgentRun {
  id                String             @id @default(uuid())
  ticketId          String
  ticket            Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  status            AgentRunStatus     @default(QUEUED)
  decision          AgentDecision?
  finalMessage      String?
  totalTokens       Int?
  startedAt         DateTime?
  finishedAt        DateTime?
  promptVersion     String             @default("v1.0.0")
  idempotencyKey    String             @unique
  steps             AgentStep[]
  refunds           Refund[]
  replacementOrders ReplacementOrder[]
  escalations       Escalation[]

  @@index([ticketId])
  @@map("agent_runs")
}

model AgentStep {
  id         String        @id @default(uuid())
  runId      String
  run        AgentRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepNumber Int
  type       AgentStepType
  toolName   String?
  input      Json?
  output     Json?
  latencyMs  Int?
  createdAt  DateTime      @default(now())

  @@index([runId])
  @@map("agent_steps")
}

model Refund {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(10, 2)
  status    String   @default("COMPLETED")
  reason    String
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("refunds")
}

model ReplacementOrder {
  id              String   @id @default(uuid())
  originalOrderId String
  originalOrder   Order    @relation(fields: [originalOrderId], references: [id], onDelete: Cascade)
  status          String   @default("CREATED")
  runId           String
  run             AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@map("replacement_orders")
}

model Escalation {
  id         String           @id @default(uuid())
  ticketId   String
  ticket     Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  runId      String
  run        AgentRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  reason     String
  assignedTo String?
  agent      User?            @relation("AssignedAgent", fields: [assignedTo], references: [id], onDelete: SetNull)
  status     EscalationStatus @default(PENDING)
  createdAt  DateTime         @default(now())

  @@map("escalations")
}
