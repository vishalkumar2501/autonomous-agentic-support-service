NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autonomous-agentic-support-service?schema=public
DIRECT_URL=
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0
AGENT_MAX_STEPS=8
HIGH_VALUE_THRESHOLD=20000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
DB_POOL_MAX=10
WORKER_CONCURRENCY=3
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=1
