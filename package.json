{
  "name": "autonomous-agentic-support-service",
  "version": "1.0.0",
  "description": "Enterprise autonomous AI agent customer support service with tool calling, guardrails, and audit trail",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "worker:dev": "tsx watch src/worker.ts",
    "worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "npx --yes tsx prisma/seed.ts"
  },
  "keywords": [
    "ai",
    "agentic",
    "langchain",
    "langgraph",
    "tool-calling",
    "express",
    "typescript",
    "prisma",
    "bullmq"
  ],
  "author": "vishalkumar2501",
  "license": "MIT",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@langchain/core": "^0.3.40",
    "@langchain/google-genai": "^0.1.11",
    "@langchain/langgraph": "^0.2.54",
    "@langchain/openai": "^0.4.4",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.41.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.3.19",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.17.19",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^8.57.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.2",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
